{
  "name": "pointsite-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-puck-history.mjs",
    "pointview:setup": "tsx scripts/pointview-setup.ts",
    "dev": "vite",
    "build": "vite build",
    "build:native": "node scripts/build-native.mjs",
    "start": "node dist/server/index.js",
    "dev:native": "npm run build:native && node scripts/serve-native-qa.mjs",
    "preview": "vite preview",
    "cloudflare:verify-account": "tsx scripts/verify-cloudflare-account.ts",
    "deploy": "npm run cloudflare:verify-account && npm run build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "skills:check": "node --test .agents/skills/pointsite-builder-maintain-skills/scripts/pipeline-scripts.test.mjs scripts/pipeliner-contracts.test.mjs && node .agents/skills/pointsite-builder-maintain-skills/scripts/audit-alignment.mjs && node scripts/validate-repository.mjs",
    "pipeline:health": "node .agents/skills/pointsite-builder-pipeline-health/scripts/audit-pipeline.mjs",
    "verify:live": "node .agents/skills/pointsite-builder-release-production/scripts/verify-live.mjs",
    "check": "npm run skills:check && npm run format:check && npm run typecheck && npm run lint -- --max-warnings=0 && npm run contract:lint && npm run verify:runbooks && npm run test:release && npm run test:coverage && npm run build && npm run build:native",
    "db:migrate:local": "wrangler d1 migrations apply pointsite-builder --local",
    "db:migrate:remote": "npm run cloudflare:verify-account && wrangler d1 migrations apply pointsite-builder --remote",
    "maintenance": "node scripts/maintenance.mjs",
    "verify:runbooks": "node scripts/verify-runbooks.mjs",
    "contract:lint": "redocly lint specs/001-pointsite-builder/contracts/openapi.yaml",
    "test:performance": "npm run build && tsx tests/performance/api-load.mjs && node scripts/verify-budgets.mjs",
    "release:build": "node scripts/release-native.mjs build",
    "release:canary": "node scripts/release-native.mjs canary",
    "release:production": "node scripts/release-native.mjs production",
    "test:release": "node --test scripts/release-native.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@phosphor-icons/react": "2.1.10",
    "@puckeditor/core": "0.23.0",
    "hono": "4.13.7",
    "jose": "6.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@redocly/cli": "^2.52.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "miniflare": "4.20260730.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  },
  "overrides": {
    "sharp": "0.35.4",
    "miniflare": {
      "undici": "6.28.0",
      "ws": "8.21.0"
    }
  }
}
