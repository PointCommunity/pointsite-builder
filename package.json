{
  "name": "pointsite-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "pointview:setup": "tsx scripts/pointview-setup.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cloudflare:verify-account": "tsx scripts/verify-cloudflare-account.ts",
    "deploy": "npm run cloudflare:verify-account && npm run build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "skills:check": "node --test .agents/skills/pointsite-builder-maintain-skills/scripts/pipeline-scripts.test.mjs scripts/pipeliner-contracts.test.mjs && node .agents/skills/pointsite-builder-maintain-skills/scripts/audit-alignment.mjs && node scripts/validate-repository.mjs",
    "pipeline:health": "node .agents/skills/pointsite-builder-pipeline-health/scripts/audit-pipeline.mjs",
    "verify:live": "node .agents/skills/pointsite-builder-release-production/scripts/verify-live.mjs",
    "check": "npm run skills:check && npm run format:check && npm run typecheck && npm run lint -- --max-warnings=0 && npm run contract:lint && npm run verify:runbooks && npm run test:coverage && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply pointsite-builder --local",
    "db:migrate:remote": "npm run cloudflare:verify-account && wrangler d1 migrations apply pointsite-builder --remote",
    "maintenance": "node scripts/maintenance.mjs",
    "verify:runbooks": "node scripts/verify-runbooks.mjs",
    "contract:lint": "redocly lint specs/001-pointsite-builder/contracts/openapi.yaml",
    "test:performance": "npm run build && tsx tests/performance/api-load.mjs && node scripts/verify-budgets.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@puckeditor/core": "0.23.0",
    "hono": "4.13.7",
    "jose": "6.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.4",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@redocly/cli": "^2.51.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "16.5.0",
    "jsdom": "30.0.1",
    "miniflare": "3.20250718.3",
    "prettier": "3.9.6",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "sharp": "0.35.4",
    "miniflare": {
      "undici": "6.28.0",
      "ws": "8.21.0"
    }
  }
}
