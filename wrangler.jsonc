{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pointsite-builder",
  "account_id": "bc890091d86ddf9ce669e96e79d47746",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "builder.pointatx.org",
      "custom_domain": true,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/assets/builder/*"],
  },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_VERSION": "0.1.0",
    "BUILDER_ORIGIN": "https://builder.pointatx.org",
    "STAGING_REPOSITORY": "PointCommunity/pointsite-staging",
    "PRODUCTION_ENABLED": "false",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pointsite-builder",
      "database_id": "d4f44410-3f61-47bd-976a-5595973fa6f1",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
