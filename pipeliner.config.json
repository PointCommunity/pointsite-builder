{
  "$schema": "./schema/pipeliner.schema.json",
  "version": 1,
  "repository": {
    "owner": "PointCommunity",
    "name": "pointsite-builder",
    "defaultBranch": "main",
    "projectManager": "brimdor"
  },
  "project": {
    "owner": "PointCommunity",
    "number": 1,
    "title": "PointSite Builder",
    "visibility": "PRIVATE",
    "statusField": "Status",
    "statuses": {
      "backlog": "Backlog",
      "onHold": "On Hold",
      "inProgress": "In Progress",
      "inReview": "In Review",
      "done": "Done"
    },
    "metadataFields": {
      "priority": {
        "name": "Priority",
        "options": ["P0", "P1", "P2", "P3"]
      },
      "impact": {
        "name": "Impact",
        "options": ["High", "Medium", "Low"]
      },
      "effort": {
        "name": "Effort",
        "options": ["XS", "S", "M", "L", "XL"]
      }
    }
  },
  "workflow": {
    "maxActiveIssues": 1,
    "branchPattern": "issue/{number}-{slug}",
    "issueReference": "Refs #{number}",
    "branchProtection": "disabled",
    "approvalPhrases": {
      "issueCreation": "Approved to create this exact GitHub Issue",
      "production": "Approved to merge and deploy production",
      "completion": "Approved to complete Issue #{number}",
      "nativeCandidate": "Beta approved"
    },
    "pmTesting": {
      "required": true,
      "terms": ["Project Manager QA", "PM Testing"],
      "requiredSections": [
        "target",
        "prerequisites",
        "numbered actions",
        "expected results",
        "regression checks"
      ]
    }
  },
  "quality": {
    "commands": [
      "npm run check",
      "npm run test:performance",
      "npm run test:e2e",
      "npm audit --audit-level=high",
      "git diff --check"
    ],
    "requiredChecks": [
      "Pipeline contracts",
      "Dependency security",
      "Secret security",
      "Source security"
    ]
  },
  "release": {
    "strategy": "immutable-promotion",
    "preReleaseIdentity": ["sourceCommit", "gitTree"],
    "candidateIdentity": ["sourceCommit", "gitTree", "imageDigest", "gitopsRevision"],
    "environments": [
      {
        "name": "Canary",
        "role": "review",
        "url": "https://builder-canary.eaglepass.io",
        "buildCommand": "npm run release:build",
        "deployCommand": "npm run release:canary",
        "verifyCommand": "npm run verify:live -- --environment canary",
        "approvalPhrase": "Approved to merge and deploy production",
        "promoteWithoutRebuild": false
      },
      {
        "name": "Production",
        "role": "production",
        "url": "https://builder.eaglepass.io",
        "buildCommand": "",
        "deployCommand": "npm run release:production",
        "verifyCommand": "npm run verify:live -- --environment production",
        "approvalPhrase": "Approved to merge and deploy production",
        "promoteWithoutRebuild": true
      }
    ]
  },
  "qa": {
    "mode": "circulating",
    "pms": [{ "id": "brimdor", "kind": "human" }],
    "applicationType": "web",
    "runtimePlatforms": [
      {
        "os": "browser",
        "architecture": "any"
      },
      {
        "os": "linux",
        "architecture": "amd64"
      }
    ],
    "candidateIdentity": ["sourceCommit", "gitTree"],
    "developers": [
      {
        "id": "Dev",
        "kind": "agent",
        "github": "brimdor",
        "environments": ["local-macos"]
      }
    ],
    "environments": [
      {
        "id": "local-macos",
        "os": "darwin",
        "architecture": "arm64",
        "prerequisites": [
          "Apple Silicon macOS; Node.js >=22.18.0; Git; authenticated gh for read-only Project audits",
          "Fresh task worktree; port 4173 free; local Playwright fixtures only; no production credentials required"
        ],
        "setup": [
          "node scripts/local-qa.mjs prepare",
          "npm ci",
          "npx playwright install chromium firefox webkit"
        ],
        "suite": [
          "npm run check",
          "npm run test:performance",
          "npm run test:e2e",
          "npm audit --audit-level=high",
          "git diff --check"
        ],
        "teardown": ["node scripts/local-qa.mjs cleanup"]
      }
    ],
    "turns": [
      {
        "id": "local",
        "developer": "Dev",
        "environment": "local-macos",
        "pm": "brimdor",
        "approvalPhrase": "Approved to complete Issue #{number}"
      }
    ]
  }
}
